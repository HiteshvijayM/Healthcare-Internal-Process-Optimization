# Environment configuration — PLACEHOLDERS ONLY.
#
# Constitution §6: no secret is ever committed to source control. Copy this file
# to `.env` (which is gitignored) and supply real values locally, or prefer a
# managed identity so no secret exists on disk at all.
#
# Note that NONE of these are required to run the evaluation harness or the test
# suite. The deterministic core has no model backend and no network dependency —
# that is what makes P7 reproducibility achievable rather than aspirational.

# --- Conversational surface (F22, P9) -------------------------------------
# Only needed to run the interactive Copilot SDK surface.
COPILOT_ENDPOINT=
COPILOT_API_KEY=

# --- Model backend for extraction and drafting (F2, F9) -------------------
# Only needed in `live` or `record` extraction mode. The harness runs in
# `replay`, where a cache miss is a hard error rather than a silent live call.
MODEL_ENDPOINT=
MODEL_DEPLOYMENT=
# Prefer managed identity over a key. If both are set, identity wins.
AZURE_CLIENT_ID=
MODEL_API_KEY=

# --- Telemetry (optional) -------------------------------------------------
# The identifier-masking filter is installed on the exporter before any span
# leaves the process. Do not point this anywhere that has not been reviewed.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Extraction mode ------------------------------------------------------
# live | record | replay.  Default and harness-required value is `replay`.
EXTRACTION_MODE=replay
